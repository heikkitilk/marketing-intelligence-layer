{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-review-queue.schema.json",
  "title": "Pending human review queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_kind", "source_sha256", "source_payload_sha256", "machine_qualified_count", "machine_rejected_count", "review_candidate_count", "exact_duplicates_collapsed", "candidates", "queue_sha256"],
  "properties": {
    "schema_version": {"const": "human-review-queue/v1"},
    "source_kind": {"const": "value-probe-receipt"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "machine_qualified_count": {"type": "integer", "minimum": 0},
    "machine_rejected_count": {"type": "integer", "minimum": 0},
    "review_candidate_count": {"type": "integer", "minimum": 0},
    "exact_duplicates_collapsed": {"type": "integer", "minimum": 0},
    "queue_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "title", "content", "action", "topic", "learning_type", "claim_label", "source_topic", "source_type", "evidence_uris", "source_candidate_ids", "support_count", "review_status"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate-[a-f0-9]{24}$"},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "topic": {"enum": ["demand_generation", "paid_advertising", "seo", "content_marketing", "attribution_measurement", "product_marketing", "activation_onboarding", "leadership_strategy", "ai_and_marketing_operations"]},
        "learning_type": {"enum": ["metric", "finding", "formula", "win", "loss", "callout", "channel"]},
        "claim_label": {"enum": ["[DATA]", "[LOGIC]", "[HYPOTHESIS]"]},
        "source_topic": {"type": "string"},
        "source_type": {"type": "string"},
        "evidence_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^session://(codex|claude)/[^@\\s]+@[a-f0-9]{64}#event=[^\\s]+$"}},
        "source_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "support_count": {"type": "integer", "minimum": 1},
        "review_status": {"const": "pending"}
      }
    }
  }
}
