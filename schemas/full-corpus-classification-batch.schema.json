{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full-corpus classification batch result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": {"type": "string", "const": "full-corpus-classification-result/v1"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_item_id", "group_id", "classification", "rationale"],
        "properties": {
          "work_item_id": {"type": "string", "pattern": "^work-[a-f0-9]{24}$"},
          "group_id": {"type": "string", "pattern": "^dependence-[a-f0-9]{24}$"},
          "classification": {"type": "string", "enum": ["marketing_bearing", "not_marketing", "mixed_work"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
