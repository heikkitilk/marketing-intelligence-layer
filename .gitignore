# Your intelligence layer and your notes are yours — they stay local.
index.html
config.json
.processed.md
raw/.processed.md

# Everything you drop in raw/ and everything processed out of it
raw/*
!raw/example-notes.md
archive/*
!archive/.gitkeep

.DS_Store
.claude/settings.local.json

# U8 derives only redacted, private local artifacts. Never track source transcripts,
# packets, provider responses, or run receipts.
.u8-private/

# Python build and test caches.
__pycache__/
*.py[cod]
*.egg-info/
